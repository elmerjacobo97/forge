{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forge-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "ForgeMcp",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ForgeMcp"],
    },
  ],
  "observability": {
    "enabled": true,
  },
}
