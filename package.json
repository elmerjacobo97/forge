{
  "name": "forge-workspace",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @forge/web dev",
    "build": "pnpm run build:core && pnpm run build:web && pnpm run build:cli",
    "build:core": "pnpm --filter @forge/core build",
    "build:web": "pnpm --filter @forge/web build",
    "build:cli": "pnpm --filter ./apps/cli build",
    "start": "pnpm --filter @forge/web start",
    "test": "pnpm run test:core && pnpm run test:web && pnpm run test:cli && pnpm run test:mcp",
    "test:core": "pnpm --filter @forge/core test",
    "test:core:watch": "pnpm --filter @forge/core test:watch",
    "test:core:coverage": "pnpm --filter @forge/core test:coverage",
    "test:web": "pnpm --filter @forge/web test",
    "test:web:watch": "pnpm --filter @forge/web test:watch",
    "test:web:coverage": "pnpm --filter @forge/web test:coverage",
    "test:cli": "pnpm --filter ./apps/cli test",
    "test:cli:watch": "pnpm --filter ./apps/cli test:watch",
    "test:cli:coverage": "pnpm --filter ./apps/cli test:coverage",
    "test:mcp": "pnpm --filter @forge/mcp test",
    "dev:mcp": "pnpm --filter @forge/mcp dev",
    "test:watch": "pnpm --parallel --filter @forge/core --filter @forge/web --filter ./apps/cli run test:watch",
    "test:coverage": "pnpm run test:core:coverage && pnpm run test:web:coverage && pnpm run test:cli:coverage",
    "check-cli-release-tag": "pnpm --filter ./apps/cli check-release-tag",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctor": "pnpm --filter @forge/web run doctor"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "typescript-eslint": "^8.64.0"
  }
}
